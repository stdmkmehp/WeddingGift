# 构建产物（仅匹配仓库根的二进制，避免误伤 cmd/wedding 等目录）
/bin/
/dist/
/wedding
*.exe

# 运行时数据、备份、秘密（绝不进 Git）
/data/
*.db
*.db-wal
*.db-shm
secrets/
app.key

# 真实导入数据（仅虚构数据允许进 Git，见 testdata/fixtures/）
/import/
*.real.csv
*.real.json

# 本机备份产物
/backups/

# M2 staging 自检记录（含机器现状信息，留档于 staging 本地，不进 Git）
/ops/records/

# Playwright CLI 临时产物（页面快照 / 控制台日志，仅本地排查用）
/.playwright-cli/

# IDE / OS
.DS_Store
.idea/
.vscode/

# 测试与覆盖率
*.out
coverage.*
